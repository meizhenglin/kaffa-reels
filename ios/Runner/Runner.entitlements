<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Universal Links：两个域名都声明；
	     AASA 实际部署在 tv.qahwatv.com（apex 的返回 404 HTML） -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:qahwatv.com</string>
		<string>applinks:tv.qahwatv.com</string>
	</array>
	<!-- Sign in with Apple：iOS 提供三方登录时按 Guideline 4.8 必须提供 -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
</dict>
</plist>
